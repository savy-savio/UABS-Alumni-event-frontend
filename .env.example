# Backend base URL. Leave empty to run in demo mode (local sample data).
# Endpoints used:
#   POST {VITE_API_URL}/register               -> { reference }
#   POST {VITE_API_URL}/admin/login            -> { token }
#   GET  {VITE_API_URL}/admin/registrations    -> [ {id, reference, name, matric, programme, email, registeredAt, checkedInAt} ]
#   POST {VITE_API_URL}/admin/checkin          -> { status: "checked_in" | "already" | "invalid", registrant }
VITE_API_URL=
